{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(pytest *)",
      "Bash(ruff *)",
      "mcp__playwright"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)",
      "Edit(./.github/**)",
      "Edit(./Dockerfile)",
      "Edit(./requirements.txt)",
      "Edit(./requirements-dev.txt)",
      "Edit(./ruff.toml)"
    ]
  }
}